      "stage": "v0.1",
      "title": "First vertical read slice",
      "owner_role": "implementer",
      "depends_on": [
        "T02",
        "T03",
        "T04"
      ],
      "status": "rework",
      "allowed_paths": [
        "internal/application/read.go",
        "internal/application/read_test.go",
        "internal/application/sections.go",
        "internal/cli/reads.go",
        "internal/cli/artifacts.go",
        "internal/adapters/http/**",
        "tests/e2e/**"
      ],
      "acceptance": [
        "Real executable subprocess and required read cases",
        "Real CLI JSON exit stderr tests",
        "No hidden writes",
        "Fields and pagination preserve facts"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": false
    },
    {
