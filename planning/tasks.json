      "acceptance": [
        "Activated skill budget measured",
        "Tuned baseline evaluated with equal correctness",
        "No unimplemented commands advertised"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": false
    },
    {
