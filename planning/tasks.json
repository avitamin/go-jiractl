        "T01"
      ],
      "status": "ready_for_review",
      "allowed_paths": [
        "internal/output/**",
        "internal/store/**",
        "internal/cli/export_linux_test.go"
      ],
      "acceptance": [
        "Byte budget and Unicode safe",
        "Lossless spill and range read",
        "Atomic publication and namespace tests"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": false
    },
    {
      "id": "T04",
      "stage": "v0.1",
      "title": "Jira mock, wire fixtures and baseline harness",
      "owner_role": "implementer",
      "depends_on": [
        "T01"
      ],
      "status": "in_progress",
      "allowed_paths": [
        "internal/testjira/**",
        "tests/fixtures/**",
        "tests/golden/**",
        "bench/**"
      ],
      "acceptance": [
        "Required mock self-tests JM-A01…JM-A10",
        "Synthetic deterministic corpus and independent Jira wire fixtures",
        "Tuned/default MCP baselines recorded",
        "No fabricated usage numbers"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": false
    },
    {
