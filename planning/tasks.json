      "acceptance": [
        "Only approved supported write operations dispatch",
        "Metadata payload parity",
        "Server E2E: user executes manual write steps; agent waits for completion then verifies by reads",
        "Retries fixes and cleanup are manual user actions; automated write tests use local synthetic mocks only"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": true
    },
