{
  "schema_version": "jiractl.tasks.v1",
  "orchestrator": "human_or_codex_integrator_not_custom_workflow_engine",
  "default_stage": "v0.1",
  "max_active_subagents": 3,
  "max_correction_rounds": 2,
  "tasks": [
    {
      "id": "T-TOOLING",
      "stage": "future",
      "title": "Go pack validator and pinned upstream inventory",
      "owner_role": "implementer",
      "depends_on": [],
      "status": "pending",
      "allowed_paths": [
        "cmd/packcheck/**",
        "cmd/inventory/**",
        "internal/tooling/**"
      ],
      "acceptance": [
        "Validate schemas, references and command registry with deterministic Go tests",
        "Extract pinned upstream inventory without executing upstream code; report static/runtime evidence separately"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": true
    },
    {
      "id": "T00",
      "stage": "v0.1",
      "title": "Reference and deployment preflight",
      "owner_role": "integrator",
      "depends_on": [],
      "status": "accepted",
      "allowed_paths": [
        "planning/reference-inventory.json",
        "planning/coverage.json",
        "docs/deployment-profile.md",
        "evidence/preflight.json"
      ],
      "acceptance": [
        "Pinned source and runtime inventory status explicit",
        "Target version, identity and live-access gaps recorded"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": false
    },
    {
      "id": "T01",
      "stage": "v0.1",
      "title": "Freeze contract and skeleton",
      "owner_role": "integrator",
      "depends_on": [
        "T00"
      ],
      "status": "accepted",
      "allowed_paths": [
        "contracts/**",
        "docs/**",
        "internal/**",
        "go.mod",
        "go.sum",
        ".github/**",
        "cmd/jiractl/**",
        "Makefile"
      ],
      "acceptance": [
        "Schema examples pass",
        "Accepted contract and lock documented",
        "Initial CI and ownership defined"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": false
    },
    {
      "id": "T02",
      "stage": "v0.1",
      "title": "Config PAT HTTP transport",
      "owner_role": "implementer",
      "depends_on": [
        "T01"
      ],
      "status": "rework",
      "allowed_paths": [
        "internal/config/**",
        "internal/adapters/http/**",
        "internal/security/**",
        "tests/e2e/**"
      ],
      "acceptance": [
        "TLS/context path/redirect tests pass",
        "Semantic read retries bounded",
        "No canary secret leakage"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": false
    },
    {
      "id": "T03",
      "stage": "v0.1",
      "title": "JSON output and artifact store",
      "owner_role": "implementer",
