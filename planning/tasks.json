      "stage": "v0.2",
      "title": "Independent write acceptance",
      "owner_role": "integrator",
      "depends_on": [
        "T11"
      ],
      "status": "pending",
      "allowed_paths": [
        "docs/release-v0.2.md",
        "evidence/release-v0.2/**"
      ],
      "acceptance": [
        "Write safety review",
        "Lost-response scenario verified on local synthetic mocks; no agent real Jira writes",
        "Live evidence separates user-reported manual actions from agent-observed read state and remaining gaps",
        "No exactly-once or approval overclaims"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": true
