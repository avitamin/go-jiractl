      "acceptance": [
        "Digest TTL profile principal checks",
        "Crash uncertainty and no blind retry",
        "Residual TOCTOU explicit"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": true
    },
    {
      "id": "T11",
      "stage": "v0.2",
      "title": "Six guarded write handlers",
      "owner_role": "implementer",
      "depends_on": [
        "T10"
      ],
      "status": "pending",
      "allowed_paths": [
        "internal/adapters/jira_dc/write/**",
        "tests/integration/write/**"
