      "allowed_paths": [
        "internal/application/snapshot.go",
        "internal/application/snapshot_test.go",
        "internal/cli/snapshots.go",
        "internal/store/**",
        "tests/e2e/**"
      ],
      "acceptance": [
        "Required snapshot resume and local-read E2E cases",
        "100 issue deterministic capture",
        "Resume completed units not refetched",
        "Partial and false-deletion tests"
      ],
      "acceptance_owner": "integrator",
      "requires_explicit_scope_extension": false
    },
    {
      "id": "T07",
      "stage": "v0.1",
      "title": "Skill and agent evaluation",
      "owner_role": "integrator",
      "depends_on": [
        "T06"
      ],
      "status": "in_progress",
      "allowed_paths": [
        "skill/**",
        ".agents/skills/jira-context/**",
        "bench/**",
        "docs/benchmark-report.md"
